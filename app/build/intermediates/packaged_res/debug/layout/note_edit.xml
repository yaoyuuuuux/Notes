                    <!--                        android:minLines="12"-->
                    <!--                        android:textAppearance="@style/TextAppearancePrimaryItem" />-->
                    <!-- ... existing code ... -->

                    <!-- ... existing code ... -->

                    <ImageButton
                        android:id="@+id/btn_ai_helper_header"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_btn_set_color"
                        android:contentDescription="AI Helper"
                        android:src="@drawable/ic_ai_helper_background"
                        android:visibility="invisible" />

                    <net.micode.notes.ui.NoteEditText
                        android:id="@+id/note_edit_view"
                        android:layout_width="fill_parent"
                        android:layout_height="match_parent"
                        android:autoLink="all"
                        android:background="@null"
                        android:gravity="start|top"
                        android:hint="@string/notelist_string_info"
                        android:lineSpacingMultiplier="1.2"
                        android:linksClickable="false"
                        android:minLines="12"
                        android:textAppearance="@style/TextAppearancePrimaryItem" />

                    <LinearLayout
                        android:id="@+id/note_edit_list"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="-10dip"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/btn_ai_helper"
                        android:layout_width="78dp"
                        android:layout_height="73dp"
                        android:layout_marginRight="10dp"
                        android:contentDescription="AI Helper"
                        android:src="@drawable/ic_ai_helper"
                        android:visibility="visible" />

                    <ImageView
                        android:id="@+id/iv_alert_icon"
                        android:layout_width="63dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/title_alert"
                        android:visibility="visible" />

                </LinearLayout>
            </ScrollView>

            <ImageView
                android:layout_width="fill_parent"
                android:layout_height="7dip"
                android:background="@drawable/bg_color_btn_mask" />
